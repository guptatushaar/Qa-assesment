{
  "name": "prism-toolshop-playwright",
  "version": "1.0.0",
  "description": "Playwright UI + API automation for Toolshop (practicesoftwaretesting.com) - QA GenAI assessment",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ui": "playwright test \"tests/UI Test\"",
    "test:api": "playwright test \"tests/API Test\"",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report execution-reports/html-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0"
  }
}
